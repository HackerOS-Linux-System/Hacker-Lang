;; Wykrywa możliwości terminala ze zmiennych środowiskowych.
pub fn detect_profile() -> int is
    if env_get("NO_COLOR") != "" is return 0 end
    let term: string = env_get("TERM")
    if term == "dumb" is return 0 end
    let ct: string = string_lower(env_get("COLORTERM"))
    if ct == "truecolor" || ct == "24bit" is return 2 end
    return 1
end

fn cube(v: int) -> int is
    return (v * 5 + 127) / 255
end

;; 0xRRGGBB → indeks palety xterm-256 (kostka 6×6×6).
pub fn to_256(c: int) -> int is
    let r: int = (c >> 16) & 255
    let g: int = (c >> 8) & 255
    let b: int = c & 255
    return 16 + 36 * cube(r) + 6 * cube(g) + cube(b)
end

fn color_seq(profile: int, c: int, is_bg: bool) -> string is
    if c < 0 || profile == 0 is return "" end
    if profile == 2 is
        let r: int = (c >> 16) & 255
        let g: int = (c >> 8) & 255
        let b: int = c & 255
        let lead: string = "38"
        if is_bg is lead = "48" end
        return "\x1b[" + lead + ";2;" + to_string(r) + ";" + to_string(g) + ";" + to_string(b) + "m"
    end
    let lead: string = "38"
    if is_bg is lead = "48" end
    return "\x1b[" + lead + ";5;" + to_string(to_256(c)) + "m"
end

;; Maluje tekst: fg/bg (−1 = domyślny), pogrubienie. Zawsze kończy resetem.
pub fn paint(profile: int, s: string, fg: int, bgc: int, bold: bool) -> string is
    if s == "" is return "" end
    let mut pre: string = ""
    if bold is pre = "\x1b[1m" end
    pre = pre + color_seq(profile, bgc, true) + color_seq(profile, fg, false)
    if pre == "" is return s end
    return pre + s + "\x1b[0m"
end
